# Окружение проекта. Скопировать в .env и заполнить; .env в .gitignore.
#
# Файл делится на две части, и это деление важно:
#
#   1) ЛОКАЛЬНОЕ — ключи к внешним сервисам. Нужны только на машине
#      разработчика и **на сервер не копируются**. Токен Serverspace
#      управляет всей учётной записью: им можно удалить любой сервер
#      и переписать DNS-зону. Если прод-ноду скомпрометируют, вместе
#      с ней не должна уехать вся инфраструктура.
#
#   2) ПРОД-ОКРУЖЕНИЕ — то, что читает docker-compose.prod.yml. Эта часть
#      копируется на сервер как /opt/yavoy/.env.

# ─── 1. Локальное: доступы к внешним сервисам ────────────────────────────

# Serverspace: сервер и DNS-хостинг (Профиль → API-ключи).
# Адрес API выбирается по первым двум символам ключа; для узбекской
# инсталляции это https://api.serverspace.uz
SERVERSPACE_API_TOKEN=

# Resend: отправка почты. Тот же ключ идёт в SMTP_URL ниже как пароль.
RESEND_API_KEY=

# Домен прод-инсталляции без схемы и www
DOMAIN=yavay.uz

# Поддомен отправки: письма уходят с mail.$DOMAIN, чтобы MX корневого домена
# остался под рабочую почту, а репутация рассылки не пачкала основной домен
MAIL_SUBDOMAIN=mail

# IPv4 прод-ноды — на него смотрят A-записи корня, www и api
SERVER_IP=89.31.28.161

# ─── 2. Прод-окружение (копируется на сервер как /opt/yavoy/.env) ────────

POSTGRES_PASSWORD=
# Пара RS256; сгенерировать: cd apps/backend && npx tsx scripts/gen-keys.ts
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
# Домены для Caddy (TLS выпускается автоматически). Прод: yavay.uz и api.yavay.uz
API_DOMAIN=
WEB_DOMAIN=
# URL API, зашиваемый в веб-клиент при сборке: https://$API_DOMAIN/v1
VITE_API_URL=
# Языки (YAV-25). DEFAULT_LOCALE — язык клиентов при первом запуске, приходит с
# сервера через GET /v1/config, поэтому меняется без пересборки приложений.
# SUPPORTED_LOCALES — что показывать в переключателе (невычитанный язык можно скрыть).
# MAIL_LOCALE — язык всех исходящих писем, один на установку.
DEFAULT_LOCALE=ru
SUPPORTED_LOCALES=ru,en,uz
MAIL_LOCALE=ru

# Эквайринг (YAV-21). none — оплаты нет, бронь подтверждает менеджер вручную.
# Для узбекской инсталляции: PAYMENT_PROVIDER=octo, CURRENCY=UZS.
PAYMENT_PROVIDER=none
# Валюта инсталляции. Уезжает в GET /v1/config, проставляется новым турам и
# броням и уходит в платёжного провайдера. Символ рисуют клиенты по этому коду.
CURRENCY=RUB
# Страна инсталляции (RU | UZ): от неё зависят тексты витрины — названия
# подставляются в нужном падеже из каталога переводов
COUNTRY=RU
# Публичный URL API: на него OCTO шлёт коллбэк (PUBLIC_API_URL/v1/webhooks/octo)
PUBLIC_API_URL=
# Куда вернуть покупателя с платёжной страницы
PAYMENT_RETURN_URL=
# Сколько минут бронь ждёт оплату, потом снимается и места возвращаются
PAYMENT_TTL_MIN=30
# Реквизиты магазина из личного кабинета merchant.octo.uz
# OCTO_SHOP_ID=
# OCTO_SECRET=
# Ключ подписи коллбэков — выдаётся техподдержкой OCTO, это НЕ OCTO_SECRET
# OCTO_NOTIFY_SECRET=
# true — тестовые транзакции; перед боем поставить false
OCTO_TEST=true

# Почта. В production пустой SMTP_URL валит старт: иначе коды входа молча
# пишутся в лог контейнера. MAIL_FROM обязателен вместе с SMTP_URL и должен
# быть на домене, который подписан DKIM, иначе письма уедут в спам.
#
# Прод yavay.uz: Resend, домен mail.yavay.uz. Порт 2465, а не 465 — хостер
# режет исходящие 25/465/587, открыты 2465/2587/2525.
# SMTP_URL=smtps://resend:<RESEND_API_KEY>@smtp.resend.com:2465
# MAIL_FROM="YaVoy <noreply@mail.yavay.uz>"
# ADMIN_EMAIL=
