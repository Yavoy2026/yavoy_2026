# Локальная разработка (docker-compose postgres на 5433)
DATABASE_URL=postgres://yavoy:yavoy@localhost:5433/yavoy
PORT=3000
HOST=0.0.0.0
# JWT RS256; в dev при отсутствии ключей генерируются эфемерные (см. src/auth/keys.ts)
# JWT_PRIVATE_KEY_PEM=
# JWT_PUBLIC_KEY_PEM=
# Языки (YAV-25): дефолт клиентов, список для переключателя, язык писем
DEFAULT_LOCALE=ru
SUPPORTED_LOCALES=ru,en,uz
MAIL_LOCALE=ru
# Эквайринг (YAV-21): none | octo. Для узбекской инсталляции — octo + CURRENCY=UZS
PAYMENT_PROVIDER=none
CURRENCY=RUB
PAYMENT_TTL_MIN=30
# PUBLIC_API_URL=http://localhost:3002
# PAYMENT_RETURN_URL=http://localhost:5175/profile
# OCTO_SHOP_ID=
# OCTO_SECRET=
# OCTO_NOTIFY_SECRET=
OCTO_TEST=true
