# Локальная разработка (docker-compose postgres на 5433)
DATABASE_URL=postgres://yavoy:yavoy@localhost:5433/yavoy
PORT=3000
HOST=0.0.0.0
# JWT RS256; в dev при отсутствии ключей генерируются эфемерные (см. src/auth/keys.ts)
# JWT_PRIVATE_KEY_PEM=
# JWT_PUBLIC_KEY_PEM=
# Языки (YAV-25): дефолт клиентов, список для переключателя, язык писем
DEFAULT_LOCALE=ru
SUPPORTED_LOCALES=ru,en,uz
MAIL_LOCALE=ru
