# Прод-окружение (docker-compose.prod.yml). Скопировать в deploy/.env и заполнить.
POSTGRES_PASSWORD=
# Пара RS256; сгенерировать: cd apps/backend && npx tsx scripts/gen-keys.ts
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
# Домены для Caddy (TLS автоматически). Без своего домена подойдёт sslip.io:
#   WEB_DOMAIN=<ip>.sslip.io  API_DOMAIN=api.<ip>.sslip.io
API_DOMAIN=
WEB_DOMAIN=
# URL API, зашиваемый в веб-клиент при сборке: https://$API_DOMAIN/v1
VITE_API_URL=
# Языки (YAV-25). DEFAULT_LOCALE — язык клиентов при первом запуске, приходит с
# сервера через GET /v1/config, поэтому меняется без пересборки приложений.
# SUPPORTED_LOCALES — что показывать в переключателе (невычитанный язык можно скрыть).
# MAIL_LOCALE — язык всех исходящих писем, один на установку.
DEFAULT_LOCALE=ru
SUPPORTED_LOCALES=ru,en,uz
MAIL_LOCALE=ru

# Эквайринг (YAV-21). none — оплаты нет, бронь подтверждает менеджер вручную.
# Для узбекской инсталляции: PAYMENT_PROVIDER=octo, CURRENCY=UZS.
PAYMENT_PROVIDER=none
# Валюта инсталляции. Уезжает в GET /v1/config, проставляется новым турам и
# броням и уходит в платёжного провайдера. Символ рисуют клиенты по этому коду.
CURRENCY=RUB
# Публичный URL API: на него OCTO шлёт коллбэк (PUBLIC_API_URL/v1/webhooks/octo)
PUBLIC_API_URL=
# Куда вернуть покупателя с платёжной страницы
PAYMENT_RETURN_URL=
# Сколько минут бронь ждёт оплату, потом снимается и места возвращаются
PAYMENT_TTL_MIN=30
# Реквизиты магазина из личного кабинета merchant.octo.uz
# OCTO_SHOP_ID=
# OCTO_SECRET=
# Ключ подписи коллбэков — выдаётся техподдержкой OCTO, это НЕ OCTO_SECRET
# OCTO_NOTIFY_SECRET=
# true — тестовые транзакции; перед боем поставить false
OCTO_TEST=true

# Почта (опционально; без SMTP_URL письма только в лог)
# SMTP_URL=smtp://user:pass@host:465
# MAIL_FROM=noreply@yavoy.ru
# ADMIN_EMAIL=
