# Доступы к инфраструктуре: Serverspace (сервер + DNS-хостинг).
# Скопировать в deploy/infra.env и заполнить. Файл в .gitignore.
#
# ВАЖНО: это НЕ .env приложения и на сервер он не копируется.
# Токен Serverspace управляет всей учётной записью — им можно создать и удалить
# любой сервер и переписать DNS-зону. На прод-ноде ему делать нечего: если
# контейнер или сам хост скомпрометируют, вместе с ними уедет вся инфраструктура.
# Поэтому прод-секреты живут в deploy/.env на сервере, а этот файл — только локально.

# Публичный API-ключ из панели Serverspace (Профиль → API-ключи)
SERVERSPACE_API_TOKEN=

# Домен прод-инсталляции без схемы и www
DOMAIN=yavay.uz

# Поддомен, с которого Mailgun шлёт почту: письма уходят с mg.$DOMAIN,
# чтобы MX корневого домена остался под рабочую почту, а репутация
# рассылки не пачкала основной домен
MAIL_SUBDOMAIN=mg

# IPv4 прод-ноды. Заполняется после создания сервера — на него смотрят
# A-записи корня, www и api
SERVER_IP=89.31.28.161
